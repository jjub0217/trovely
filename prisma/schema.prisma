generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ReelSource {
  instagram
  youtube
}

model Reel {
  id         String         @id @default(cuid())
  url        String
  thumbnail  String?
  caption    String?
  memo       String?
  review     String?
  visited    Boolean        @default(false)
  source     ReelSource     @default(instagram)
  userId     String
  categories ReelCategory[]
  tags       ReelTag[]
  embedding  ReelEmbedding?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([url, userId])
  @@index([userId])
}

model Category {
  id     String         @id @default(cuid())
  name   String
  userId String
  reels  ReelCategory[]

  @@unique([name, userId])
  @@index([userId])
}

model ReelCategory {
  reelId     String
  categoryId String
  reel       Reel     @relation(fields: [reelId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([reelId, categoryId])
}

model Tag {
  id     String    @id @default(cuid())
  name   String
  userId String
  reels  ReelTag[]

  @@unique([name, userId])
  @@index([userId])
}

model AdminRole {
  userId String @id
  email  String
  createdAt DateTime @default(now())
}

// 탈퇴 통계용: 개인을 알아볼 수 있는 정보(이메일, 사용자 ID, 직접 쓴 사유)는 남기지 않는다
model Withdrawal {
  id        String   @id @default(cuid())
  reason    String
  createdAt DateTime @default(now())
}

model ReelTag {
  reelId String
  tagId  String
  reel   Reel @relation(fields: [reelId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([reelId, tagId])
}

model ReelEmbedding {
  reelId    String                     @id
  reel      Reel                       @relation(fields: [reelId], references: [id], onDelete: Cascade)
  embedding Unsupported("vector(768)")
  textHash  String
  updatedAt DateTime                   @updatedAt
}

model ImportBatch {
  id         String            @id @default(cuid())
  userId     String
  createdAt  DateTime          @default(now())
  candidates ImportCandidate[]

  @@index([userId])
}

model ImportCandidate {
  id                  String      @id @default(cuid())
  batchId             String
  batch               ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  url                 String
  caption             String
  savedAt             DateTime
  keptCategories      String[]
  fromCollections     String[]
  needsAi             Boolean
  suggestedCategories String[]
  newCategories       String[]
  tags                String[]
  uncertain           Boolean     @default(false)
  suggested           Boolean     @default(false)
  status              String      @default("pending")

  @@unique([batchId, url])
  @@index([batchId, status])
}

// AI 검색(비슷한 콘텐츠 찾기) 동의 현재 상태. generation은 동의를 켜거나 끌 때마다 1씩 올라간다(작업 버전)
model AiSearchConsent {
  userId        String    @id
  enabled       Boolean
  policyVersion String
  generation    Int       @default(0)
  consentedAt   DateTime?
  revokedAt     DateTime?
  // 게시물 전체 만들기가 도는 중이면 끝날 예정 시각(한 사람에게 작업 하나만 돌게 한다)
  buildingUntil DateTime?
}

// AI 검색 동의와 철회 이력. 탈퇴하면 지운다
model AiSearchConsentLog {
  id            String   @id @default(cuid())
  userId        String
  action        String // "consent" | "revoke"
  policyVersion String
  createdAt     DateTime @default(now())

  @@index([userId])
}

// 같은 날 같은 검색어의 벡터 재사용. 검색어 원문은 저장하지 않고 해시만. embedding이 비어 있으면 만드는 중
model QueryEmbeddingCache {
  userId    String
  day       String // 한국 날짜 YYYY-MM-DD
  model     String
  textHash  String
  embedding Unsupported("vector(768)")?
  createdAt DateTime                    @default(now())

  @@id([userId, day, model, textHash])
}

// 가입자별 하루 AI 사용량
model AiUsageUser {
  userId String
  day    String
  kind   String // "query" | "document"
  count  Int    @default(0)

  @@id([userId, day, kind])
}

// 서비스 전체 하루 AI 사용량
model AiUsageTotal {
  day   String
  kind  String
  count Int    @default(0)

  @@id([day, kind])
}
