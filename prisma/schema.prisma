generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ReelSource {
  instagram
  youtube
}

model Reel {
  id         String         @id @default(cuid())
  url        String
  thumbnail  String?
  caption    String?
  memo       String?
  review     String?
  visited    Boolean        @default(false)
  source     ReelSource     @default(instagram)
  userId     String
  categories ReelCategory[]
  tags       ReelTag[]
  embedding  ReelEmbedding?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([url, userId])
  @@index([userId])
}

model Category {
  id     String         @id @default(cuid())
  name   String
  userId String
  reels  ReelCategory[]

  @@unique([name, userId])
  @@index([userId])
}

model ReelCategory {
  reelId     String
  categoryId String
  reel       Reel     @relation(fields: [reelId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([reelId, categoryId])
}

model Tag {
  id     String    @id @default(cuid())
  name   String
  userId String
  reels  ReelTag[]

  @@unique([name, userId])
  @@index([userId])
}

model AdminRole {
  userId String @id
  email  String
  createdAt DateTime @default(now())
}

// 탈퇴 통계용: 개인을 알아볼 수 있는 정보(이메일, 사용자 ID, 직접 쓴 사유)는 남기지 않는다
model Withdrawal {
  id        String   @id @default(cuid())
  reason    String
  createdAt DateTime @default(now())
}

model ReelTag {
  reelId String
  tagId  String
  reel   Reel @relation(fields: [reelId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([reelId, tagId])
}

model ReelEmbedding {
  reelId    String                     @id
  reel      Reel                       @relation(fields: [reelId], references: [id], onDelete: Cascade)
  embedding Unsupported("vector(768)")
  textHash  String
  updatedAt DateTime                   @updatedAt
}

model ImportBatch {
  id         String            @id @default(cuid())
  userId     String
  createdAt  DateTime          @default(now())
  candidates ImportCandidate[]

  @@index([userId])
}

model ImportCandidate {
  id                  String      @id @default(cuid())
  batchId             String
  batch               ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  url                 String
  caption             String
  savedAt             DateTime
  keptCategories      String[]
  fromCollections     String[]
  needsAi             Boolean
  suggestedCategories String[]
  newCategories       String[]
  tags                String[]
  uncertain           Boolean     @default(false)
  suggested           Boolean     @default(false)
  status              String      @default("pending")

  @@unique([batchId, url])
  @@index([batchId, status])
}
